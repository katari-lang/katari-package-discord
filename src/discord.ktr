// The Discord library: a bot-token capability, the message plane (in and out), and one blocking
// question (`ask`). The externals are implemented in `discord.ts`.
// Every call takes the token plus a channel and nothing holds a live connection, so a restart costs
// the interrupted call and nothing else. Twin of the `slack` package, whose README lists the divergences.

@"The Discord bot-token capability, provided by `use discord.provider(...)` and resolved per call, so a
token rotation lands without a restart."
request credential() -> string of private

@"Provide the `credential` capability from @source@ for the extent of the continuation. @source@ is a
name, not a value: resolution happens at each use. Nothing connects here, so a bad token surfaces at
the call that wanted the gateway rather than at this install site."
agent provider[R, effect E](
  @"Where the bot token lives (env key or oauth name)." source: credentials.source,
  @"Runs with `credential` served; its result is the provider's result." continuation: agent (value: null) -> R with {...E, credential},
) -> R with E | io | prelude.throw[env.missing_secret | oauth.server_error] {
  use handler {
    request credential() -> string of private { next credentials.resolve(source = source) }
  }
  continuation(value = null)
}

@"An authentication or authorization failure: the bot token is invalid or expired (401), or the bot
lacks permission in the channel (403); @message@ carries Discord's error. Only an operator can fix it,
so let it surface rather than silently dropping every reply."
data auth_error(message: string)

@"A Discord API call failed for a non-auth reason: a rate limit (429), a channel that is not a sendable
text channel, a payload the platform rejects, a transient network fault; @message@ carries Discord's
error. Usually per-message or transient, so a bot can catch it to drop just that reply and keep serving."
data api_error(message: string)

// Raised as a `prelude.throw`, never a panic, and classified in the sidecar by HTTP status.
// (Type synonyms take no docs, so this is a `//`.)
type discord_error = auth_error | api_error

// ── the message plane: what arrives, and what goes out ───────────────────────────────────────────

@"One incoming message: what arrived, where, from whom, and with what attached."
data message(
  @"This message's own id (a snowflake) — the same kind of value `send_message` returns, and the cursor `list_messages` reads after. Keep the id of the last message you handled or a gap cannot be closed later, because Discord backfills nothing." id: string,
  @"The channel the message arrived on — hand it straight to `send_message` to reply in place." channel: string,
  @"The sender's raw Discord user id (a snowflake)." author: string,
  @"The name Discord's own client shows for the sender: per-server nickname, else global display name, else username. Self-chosen and not unique, so it is not an identity — authorize on @author@ (or on a tag derived from it), never on this." display_name: string,
  @"The message text; empty for an attachments-only post." text: string,
  @"The attachments, already downloaded into `file` values." files: array[file],
)

@"Low-level: post to a channel with the bot @token@, with any files as attachments, returning the
posted message's id. A plain REST call, so it behaves identically before and after a restart. Raises
`discord_error` when the call fails. Prefer the send_message agent."
external agent discord_send(
  @"The bot token to post with." token: string of private,
  @"The channel to post into." channel: string,
  @"The message text; empty means an attachments-only post." text: string,
  @"Files to attach to the post." files: array[file],
) -> string with prelude.throw[discord_error]

@"Low-level: read a channel's recent messages with the bot @token@. A plain REST call. @limit@ is
clamped into Discord's own 1-100 here, and the answer is reversed into posted order (Discord answers
newest first). Raises `discord_error` when the call fails. Prefer the list_messages agent."
external agent discord_history(
  @"The bot token to read with." token: string of private,
  @"The channel to read." channel: string,
  @"Read only messages posted after this message id; empty reads the newest page." after: string,
  @"How many messages to ask Discord for; clamped into 1-100." limit: integer,
) -> array[message] with prelude.throw[discord_error]

@"Low-level: listen on a channel with the bot @token@ and deliver each incoming message as one
`message` value to a callback. The sidecar opens the gateway socket for this call's lifetime (shared
with any other live watch or `ask` on the same token, closed when the last of them ends) and attaches
the listener before the socket comes up, so nothing arriving on a fresh connection is
delivered to nobody. Raises `discord_error` when the gateway will not open. Prefer the watch_messages agent."
external agent discord_watch[effect E](
  @"The bot token to listen with." token: string of private,
  @"The channel to listen on." channel: string,
  @"Called once per incoming message; its effects E flow to the caller's handlers." deliver_to: agent (value: message) -> null with E,
) -> never with E | prelude.throw[discord_error]

@"Post a message to a channel with the ambient bot token, returning the posted message's id — the seam
a later edit or thread-reply addresses a message by. @files@ attach to the post. Raises `discord_error`:
catch `api_error` to keep a bot serving past a transient failure, and let `auth_error` surface so a bad
token stops the bot loudly."
agent send_message(
  @"The channel to post into." channel: string,
  @"The message text; empty means an attachments-only post." text: string,
  @"Files to attach; defaults to none." files: array[file] ?= [],
) -> string {
  discord_send(token = credential(), channel = channel, text = text, files = files)
}

@"A `try_send` that reached the channel: the message is posted. It carries nothing — a caller that
wants the posted message's id wants `send_message` and its own error policy."
data delivered()

@"A `try_send` that posted nothing, with @reason@ saying which of the two silences it was: the
transient `api_error` this agent swallowed, or a blank text with no files."
data dropped(@"Why nothing was posted, in one clause." reason: string)

// What became of one resilient post: it landed, or it did not and here is why.
type send_outcome = delivered | dropped

@"Post resiliently, fire-and-forget: a blank @text@ with no @files@ posts nothing, a transient
`api_error` (a rate limit, an unsendable channel) drops just this post so the bot keeps serving, and
`auth_error` re-raises so a bad token still stops the bot loudly. It answers with the outcome rather
than a silence, so a caller cannot report success for a post the channel never received; the posted
message's id is not carried."
agent try_send(
  @"The channel to post into." channel: string,
  @"The message text; blank with no files posts nothing." text: string,
  @"Files to attach; defaults to none." files: array[file] ?= [],
) -> send_outcome {
  if (string.trim(value = text) == "" && array.length(target = files) == 0) {
    dropped(reason = "the text was blank and no files were attached, so there was nothing to post")
  } else {
    use handler {
      request prelude.throw(error: discord_error) -> never {
        match (error) {
          case api_error(message => message) -> { break dropped(reason = f"Discord refused the post (${message})") }
          // The residual is exactly `auth_error` — rethrown as bound, no reconstruction.
          case rest -> { prelude.throw(error = rest) }
        }
      }
    }
    let _message_id = send_message(channel = channel, text = text, files = files)
    delivered()
  }
}

@"Serve a channel forever, delivering each incoming message to @deliver_to@ as one `message` value;
shaped like `time.watch` so it composes under `parallel [ … ]`. Bot posts (this bot's own replies
included) are not delivered, so replying from @deliver_to@ cannot loop. Raises `discord_error` when the
gateway will not open — opening it is this call's job, so an invalid token stops the watch as
`auth_error` rather than failing the provider.

Delivery is exactly once within one live gateway connection and guaranteed neither way across a
reconnect or a runtime restart: the gateway has no per-event acknowledgement and Discord backfills
nothing onto a fresh session, so a message can be missed, far more rarely repeated, and nothing here
dedups. A bot that must miss nothing keeps the `id` of the last message it handled somewhere durable
and closes the gap with `list_messages`.

@author@ is an enumerable snowflake, so pass it through `crypto.pseudonym` before letting it leave the
program. @display_name@ beside it is self-chosen and not unique: address with it, authorize on @author@."
agent watch_messages[effect E](
  @"The channel to serve." channel: string,
  @"Called once per incoming message, with the whole message as one value; its effects E flow to the caller's handlers." deliver_to: agent (value: message) -> null with E,
) -> never with E | credential | io | prelude.throw[discord_error] {
  discord_watch(token = credential(), channel = channel, deliver_to = deliver_to)
}

@"The channel's messages posted after @after@, in posted order — the reconciliation `watch_messages`
needs across a reconnect. @after@ is a message id, not a timestamp: keep the `id` of the last message
you handled durably and hand it back here; an empty @after@ reads the newest @limit@ instead.

The answer is the same `message` value the watch delivers, attachments downloaded and this bot's own
posts dropped — a page of image-heavy history pays for every attachment on it, so keep @limit@ to what
you will actually process. @limit@ is clamped into Discord's 1-100, so a wide gap takes several reads and an empty
page, not a short one, marks it closed. Nothing dedups. Raises `discord_error` as `send_message` does."
agent list_messages(
  @"The channel to read." channel: string,
  @"The message id to read after — the `id` of the last message you handled. Empty reads the newest @limit@ messages instead." after: string ?= "",
  @"How many messages to ask Discord for; clamped into 1-100." limit: integer ?= 50,
) -> array[message] with credential | io | prelude.throw[discord_error] {
  discord_history(token = credential(), channel = channel, after = after, limit = limit)
}

// ── the interaction plane: the controls a question offers, and the answer one of them returns ────

@"A clickable button: pressing it is the answer (`clicked`), with no second step. @id@ returns
verbatim, so a program branches on the id it wrote rather than on the label a human reads."
data button(
  @"The answer's identity; returned verbatim as `clicked.id`. At most 100 characters and never shortened — it is how Discord routes the press back, so an over-long or blank one fails the ask as `api_error`." id: string,
  @"What the button reads on screen; at most 80 characters, shortened with `…` beyond that, and rendered as @id@ when blank." label: string,
)

@"A dropdown: picking one option is the answer (`chose`), carrying the option's own text. Reach for it
when the options are data the program computed; a fixed set of choices is clearer as one `button` each,
because then every branch has an id the program named. Discord takes at most 25 options of 100
characters."
data select(
  @"The answer's identity; returned verbatim as `chose.id`. At most 100 characters and never shortened — see `button`'s @id@." id: string,
  @"The placeholder line shown while nothing is picked; at most 150 characters, shortened with `…` beyond that. Blank leaves Discord's own default line in place." label: string,
  @"The options offered; the picked one returns as `chose.option`. Each is 1 to 100 characters and is never shortened, since the option's own text is the answer: an over-long or blank one fails the ask as `api_error`." options: array[string],
)

@"One text box of a `form`: labelled, optionally prefilled, optionally multi-line. A prefilled box is
how a draft gets edited — the human submits the program's proposal changed or unchanged, so the program
never has to guess which parts were accepted."
data field(
  @"The key this box's text lands under in `submitted.values`. At most 100 characters and never shortened, so an over-long or blank one fails the ask as `api_error`." id: string,
  @"What the box is labelled on screen; at most 45 characters, shortened with `…` beyond that, and rendered as @id@ when blank." label: string,
  @"The text the box starts with — a draft to edit; defaults to empty. At most 4000 characters and never shortened, since a submit approves exactly these values: an over-long one fails the ask as `api_error`, for the program to shorten deliberately." value: string ?= "",
  @"Whether the box is a multi-line paragraph rather than one line; defaults to one line." multiline: boolean ?= false,
)

@"A form: a button that opens a dialog of @fields@, and submitting the dialog is the answer
(`submitted`), carrying every field's text. Two steps because that is Discord's physics — text input
exists only inside a dialog — so a form renders as one button reading @label@ above a dialog titled
@title@. Opening the dialog and closing it again is not an answer: the question stays open and any
control can still answer it. Discord takes 1 to 5 fields."
data form(
  @"The answer's identity; returned verbatim as `submitted.id`. At most 94 characters — six shorter than any other id, because the dialog's own identifier carries a prefix — and never shortened; an over-long or blank one fails the ask as `api_error` where the question posts." id: string,
  @"What the opening button reads on screen; at most 80 characters, shortened with `…` beyond that, and rendered as @id@ when blank." label: string,
  @"The dialog's title; keep it to 24 characters, which is the twin contract's bound rather than Discord's own 45, so a form written here also renders on the Slack twin. Past 45 it is shortened with `…`, and a blank title renders as @id@." title: string,
  @"The boxes the dialog presents, in order." fields: array[field],
)

// What a question may put in front of a human: an immediate button, a dropdown, or a form dialog.
type control = button | select | form

@"A `button` was pressed."
data clicked(
  @"The pressed button's @id@." id: string,
  @"Who answered: their raw Discord user id (a snowflake)." by: string,
  @"What the answerer is called, resolved as `message`'s @display_name@ is. Self-chosen and not unique, so it is not an identity: authorize on @by@, never on this." display_name: string,
)

@"A `select`'s option was picked."
data chose(
  @"The dropdown's @id@." id: string,
  @"The picked option, verbatim from the `select`'s @options@." option: string,
  @"Who answered: their raw Discord user id (a snowflake)." by: string,
  @"What the answerer is called, resolved as `message`'s @display_name@ is. Self-chosen and not unique, so it is not an identity: authorize on @by@, never on this." display_name: string,
)

@"A `form` was submitted: @values@ carries every declared field's text, keyed by the field's @id@ (a
box left blank is present as the empty string, so the record is total over the form's fields). A submit
means approved at these values, so acting on @values@ acts on exactly what the human read and sent."
data submitted(
  @"The submitted form's @id@." id: string,
  @"Each field's text, keyed by field id." values: record[string],
  @"Who answered: their raw Discord user id (a snowflake)." by: string,
  @"What the answerer is called, resolved as `message`'s @display_name@ is. Self-chosen and not unique, so it is not an identity: authorize on @by@, never on this." display_name: string,
)

// Which control completed the question, and with what.
type answer = clicked | chose | submitted

@"Low-level: post a prompt with its controls to a channel with the bot @token@ and await the first
completed interaction. The sidecar brings the gateway socket up before the question posts, because
Discord delivers an interaction only to a session connected at the moment of the click; that socket is
shared with any other live watch or `ask` on the same token and closes when the last of them ends.
Prefer the ask agent."
external agent discord_ask(
  @"The bot token to ask with." token: string of private,
  @"The channel to ask in." channel: string,
  @"The question posted above the controls." prompt: string,
  @"The controls to present, in order." controls: array[control],
) -> answer with prelude.throw[discord_error]

@"Post @prompt@ with @controls@ as one message and block until someone in the channel completes one of
them, returning which control answered and with what. Any member of the channel may answer and the
first completed interaction is the answer; opening a form's dialog completes nothing.

Once answered — or ended without an answer, which leaves `(expired)` — the controls are stripped off the
message and the outcome left in their place, best effort either way. That record reads as the control's
own text (a `button`'s or `form`'s @label@, a `select`'s picked @option@) and names the answerer as a
mention, while the @by@ the `answer` carries is the raw id.

`ask` holds no time limit: a deadline is `time.with_deadline` around it, a withdrawal is
`region.cancel_by_id` on the fiber holding it. A runtime restart interrupts the wait under the
at-most-once rule (a catchable panic) and leaves the posted controls stale, so a late click gets
Discord's own \"interaction failed\" notice; ask again. Raises `discord_error` when opening the gateway
(an invalid token is `auth_error`), posting the question, or opening a dialog fails.

A control past one of Discord's caps splits two ways: presentation is clamped (a @label@ or @title@ is
shortened, a blank one renders as the control's @id@), while an @id@, a `select` option, a `field`
@value@ and a count past `limits` fail the ask as `api_error`. `check_controls` answers all of that
purely, where the controls are built.

@by@ on the answer is an enumerable snowflake, so pass it through `crypto.pseudonym` before letting it
leave the program. The @display_name@ beside it is self-chosen and not unique: an answer that depends on
who gave it must read @by@."
agent ask(
  @"The channel to ask in — its membership is who may answer." channel: string,
  @"The question posted above the controls." prompt: string,
  @"What the human may complete: `button` / `select` / `form` values, rendered in order. Each control's @id@ must be distinct within one ask — the id is the correlation key Discord carries back, so a repeat is unroutable rather than merely untidy (the sidecar keeps the first and warns). Discord fits at most 5 rows on a message: up to 5 buttons share a row, each dropdown takes one of its own." controls: array[control],
) -> answer with credential | io | prelude.throw[discord_error] {
  discord_ask(token = credential(), channel = channel, prompt = prompt, controls = controls)
}

// ── the platform's numbers, and a local check against them ───────────────────────────────────────
//
// Both are pure: no credential, no io, so they run where the controls are built rather than where they
// are asked, which is the only time a check is worth running.

@"Discord's limits on what one question may present, as data. Lengths are in characters; the renderer
counts UTF-16 code units and Katari's `string.length` counts code points, so the two disagree by one per
astral character — shorten anything sitting within a couple of characters of its cap rather than
trusting either count. Each field says what happens past it: a presentation string is clamped, a
load-bearing one is fatal."
data caps(
  @"One message's text: at most this many characters, fatal past it. It caps an `ask`'s @prompt@ and `send_message` / `try_send`'s @text@, and it is the one number here that no control carries — so `check_controls` cannot see it, and a caller building a prompt out of text it did not write must bound that text itself against this." message_text: integer,
  @"A `button`'s @label@ — and a `form`'s opening button's: at most this many characters, clamped past it." button_label: integer,
  @"A `select`'s @label@, the placeholder line: at most this many characters, clamped past it. Blank is legal here alone — it leaves Discord's own default line." select_label: integer,
  @"Each of a `select`'s @options@: 1 to this many characters, fatal outside it — the option's text is the answer." select_option: integer,
  @"How many @options@ one `select` may offer: 1 to this many, fatal outside it." select_options: integer,
  @"A `form`'s @title@: at most this many characters, clamped past it. Discord's own number — the twin contract asks for 24, which is a convention rather than a cap (see `form`'s @title@)." form_title: integer,
  @"How many `field` boxes one `form`'s dialog may hold: 1 to this many, fatal outside it." form_fields: integer,
  @"A `field`'s @label@: at most this many characters, clamped past it." field_label: integer,
  @"A `field`'s @value@, the prefilled draft: at most this many characters, fatal past it — a submit approves exactly these values. Blank is legal: it is the absence of a prefill." field_value: integer,
  @"A `button`'s, `select`'s or `field`'s @id@: 1 to this many characters, fatal outside it — it is the routing key, never presentation." control_id: integer,
  @"A `form`'s @id@: 1 to this many characters, fatal outside it. Shorter than @control_id@ because the form's dialog carries a prefix on the same identifier." form_id: integer,
  @"How many rows of controls one message may carry, fatal past it." rows: integer,
  @"How many buttons share one row: buttons pack this many to a row, and each `select` takes a row of its own." buttons_per_row: integer,
)

@"Discord's caps, as one `caps` value — pure, so it composes anywhere. These numbers are duplicated in
the TypeScript sidecar's renderer, which nothing in Katari can read a constant out of;
`scripts/check-limits.mjs` fails when this agent and the sidecar's `LIMIT` disagree."
agent limits() -> caps {
  caps(
    message_text = 2000,
    button_label = 80,
    select_label = 150,
    select_option = 100,
    select_options = 25,
    form_title = 45,
    form_fields = 5,
    field_label = 45,
    field_value = 4000,
    control_id = 100,
    form_id = 94,
    rows = 5,
    buttons_per_row = 5,
  )
}

@"The controls are askable exactly as written: every string fits, every count fits, every id is
distinct, and nothing would be shortened or substituted on the way to the channel."
data valid()

@"Something about the controls will not reach the channel as written, and @reason@ names which control
and what in one line — the first problem found, in declaration order, so a fix at a time converges."
data invalid(@"Which control, and what is wrong with it." reason: string)

// The verdict `check_controls` returns: askable as written, or the first reason it is not.
type control_check = valid | invalid

@"Check @controls@ against Discord's caps locally and answer with a value — `valid`, or `invalid`
carrying one sentence naming the offending control. Pure: no credential, no io, nothing to catch, so it
belongs where the controls are built rather than where they are asked, and it is deliberately not wired
into `ask`.

What it reports is wider than what `ask` fails on, on purpose:

- Fatal, as `ask` would be: a blank or over-long @id@, a blank or over-long `select` option, a count
  outside `limits`' @select_options@ / @form_fields@ / @rows@, an over-long `field` @value@, and an
  empty @controls@ (a question nobody can answer, which Discord posts happily).
- Silent, which `ask` survives and a program still wants to know: a label, placeholder or title past
  its cap is shortened, and a blank one renders as the control's own @id@ — so the channel's lasting
  record of what was decided reads as an internal key, or as most of a sentence.
- Duplicate ids, which nothing else catches at all: Discord returns the id and nothing more, so the
  sidecar keeps the first and pressing the second control completes the first control's answer. A
  `form`'s @fields@ are checked the same way, since `submitted.values` is keyed by field id.

Lengths are counted in code points while the renderer counts UTF-16 units, so an astral character is
one here and two there."
agent check_controls(
  @"The controls one `ask` would present, in the order it would render them." controls: array[control],
) -> control_check {
  let cap = limits()

  // A presentation string, which the renderer repairs rather than refuses: blank is substituted with
  // the control's own id, over-long is shortened. Both are silent, so the report says what would be posted.
  agent clamped_label(where: string, what: string, value: string, allowed: integer) -> string {
    if (value == "") {
      f"${where}: ${what} is blank, so the control would be labelled with its own id"
    } else if (string.length(value = value) > allowed) {
      f"${where}: ${what} is ${string.length(value = value)} characters where Discord takes ${allowed}, so it would be posted shortened with an ellipsis"
    } else {
      ""
    }
  }

  // The one presentation string whose blank is meaningful: a `select` with no placeholder keeps
  // Discord's own default line.
  agent optional_label(where: string, what: string, value: string, allowed: integer) -> string {
    if (string.length(value = value) > allowed) {
      f"${where}: ${what} is ${string.length(value = value)} characters where Discord takes ${allowed}, so it would be posted shortened with an ellipsis"
    } else {
      ""
    }
  }

  // A load-bearing string: an id, an option. Shortening it would change what the question means, so the
  // renderer refuses instead — blank as hard as over-long.
  agent fatal_string(where: string, what: string, value: string, allowed: integer) -> string {
    if (value == "") {
      f"${where}: ${what} is blank, which fails the ask as api_error"
    } else if (string.length(value = value) > allowed) {
      f"${where}: ${what} is ${string.length(value = value)} characters where Discord takes ${allowed}, which fails the ask as api_error"
    } else {
      ""
    }
  }

  // Load-bearing, but legitimately absent: a `field`'s prefill. Empty means no draft; over-long is
  // fatal, because a draft docked to fit would be approved as though it were whole.
  agent optional_text(where: string, what: string, value: string, allowed: integer) -> string {
    if (string.length(value = value) > allowed) {
      f"${where}: ${what} is ${string.length(value = value)} characters where Discord takes ${allowed}, which fails the ask as api_error"
    } else {
      ""
    }
  }

  // Every check above spells `nothing wrong` as the empty string, and no real reason is empty. First in
  // declaration order wins, so a caller fixes one thing at a time.
  agent first_problem(problems: array[string]) -> string {
    for (let problem in problems, var found: string = "") {
      if (found == "" && problem != "") {
        next with { found = problem }
      } else {
        next
      }
    } then (_problems) {
      found
    }
  }

  agent id_of(control: control) -> string {
    match (control) {
      case button(id => id) -> id
      case select(id => id) -> id
      case form(id => id) -> id
    }
  }

  // Discord allows nothing beside a dropdown.
  agent takes_own_row(control: control) -> boolean {
    match (control) {
      case select(id => _) -> true
      case rest -> false
    }
  }

  // The position is stated even where there is an id, because two controls may share one — which is
  // itself among the things reported.
  agent where_of(index: integer, id: string) -> string {
    if (id == "") {
      f"control #${index + 1}"
    } else {
      f"control #${index + 1} (\"${id}\")"
    }
  }

  // Laid out exactly as the renderer lays them out: a `form` contributes only the button that opens its
  // dialog and so packs like any other, and a `select` flushes the pending buttons and takes a row alone.
  agent rows_used(controls: array[control]) -> integer {
    for (let control in controls, var rows: integer = 0, var pending: integer = 0) {
      if (takes_own_row(control = control)) {
        if (pending > 0) {
          next with { rows = rows + 2, pending = 0 }
        } else {
          next with { rows = rows + 1 }
        }
      } else if (pending == cap.buttons_per_row) {
        next with { rows = rows + 1, pending = 1 }
      } else {
        next with { pending = pending + 1 }
      }
    } then (_controls) {
      if (pending > 0) {
        rows + 1
      } else {
        rows
      }
    }
  }

  agent options_problem(where: string, options: array[string]) -> string {
    let count = array.length(target = options)
    if (count == 0) {
      f"${where}: the dropdown offers no options; Discord takes 1 to ${cap.select_options}"
    } else if (count > cap.select_options) {
      f"${where}: the dropdown offers ${count} options; Discord takes 1 to ${cap.select_options}"
    } else {
      for (let option in options, var at: integer = 0, var found: string = "") {
        let problem = fatal_string(where = where, what = f"option #${at + 1}", value = option, allowed = cap.select_option)
        if (found == "" && problem != "") {
          next with { at = at + 1, found = problem }
        } else {
          next with { at = at + 1 }
        }
      } then (_options) {
        found
      }
    }
  }

  // Box ids must be distinct: `submitted.values` is keyed by field id, so two boxes sharing one come
  // back as a single entry and the other box's text is simply gone.
  agent fields_problem(where: string, fields: array[field]) -> string {
    let count = array.length(target = fields)
    if (count == 0) {
      f"${where}: the dialog has no boxes; Discord takes 1 to ${cap.form_fields}"
    } else if (count > cap.form_fields) {
      f"${where}: the dialog has ${count} boxes; Discord takes 1 to ${cap.form_fields}"
    } else {
      for (let box in fields, var at: integer = 0, var seen: record[boolean] = {}, var found: string = "") {
        let what = f"box #${at + 1}"
        let duplicate = if (box.id != "" && record.has(target = seen, key = box.id)) {
          f"${where}: ${what} repeats the field id \"${box.id}\", so both boxes would come back as one entry of submitted.values"
        } else {
          ""
        }
        let problem = first_problem(problems = [
          fatal_string(where = where, what = f"${what}'s id", value = box.id, allowed = cap.control_id),
          duplicate,
          clamped_label(where = where, what = f"${what}'s label", value = box.label, allowed = cap.field_label),
          optional_text(where = where, what = f"${what}'s prefill", value = box.value, allowed = cap.field_value),
        ])
        if (found == "" && problem != "") {
          next with { at = at + 1, seen = record.set(target = seen, key = box.id, value = true), found = problem }
        } else {
          next with { at = at + 1, seen = record.set(target = seen, key = box.id, value = true) }
        }
      } then (_fields) {
        found
      }
    }
  }

  // The id first: it decides whether the control can be routed at all.
  agent control_problem(where: string, control: control) -> string {
    match (control) {
      case button(id => id, label => label) -> first_problem(problems = [
        fatal_string(where = where, what = "the id", value = id, allowed = cap.control_id),
        clamped_label(where = where, what = "the button's label", value = label, allowed = cap.button_label),
      ])
      case select(id => id, label => label, options => options) -> first_problem(problems = [
        fatal_string(where = where, what = "the id", value = id, allowed = cap.control_id),
        optional_label(where = where, what = "the dropdown's placeholder", value = label, allowed = cap.select_label),
        options_problem(where = where, options = options),
      ])
      case form(id => id, label => label, title => title, fields => fields) -> first_problem(problems = [
        fatal_string(where = where, what = "the id", value = id, allowed = cap.form_id),
        clamped_label(where = where, what = "the opening button's label", value = label, allowed = cap.button_label),
        clamped_label(where = where, what = "the dialog's title", value = title, allowed = cap.form_title),
        fields_problem(where = where, fields = fields),
      ])
    }
  }

  if (array.length(target = controls) == 0) {
    invalid(reason = "no controls: Discord posts the prompt happily and the question can never be answered")
  } else {
    for (let control in controls, var at: integer = 0, var seen: record[boolean] = {}, var found: string = "") {
      let id = id_of(control = control)
      let where = where_of(index = at, id = id)
      // A blank id is already reported by `control_problem` as the fatal thing it is, so it is not also
      // reported as a duplicate of the previous blank one.
      let duplicate = if (id != "" && record.has(target = seen, key = id)) {
        f"${where}: two controls share this id, and Discord carries back nothing else — the first one keeps it, so completing this control would answer as the first"
      } else {
        ""
      }
      let problem = first_problem(problems = [duplicate, control_problem(where = where, control = control)])
      if (found == "" && problem != "") {
        next with { at = at + 1, seen = record.set(target = seen, key = id, value = true), found = problem }
      } else {
        next with { at = at + 1, seen = record.set(target = seen, key = id, value = true) }
      }
    } then (_controls) {
      if (found != "") {
        invalid(reason = found)
      } else if (rows_used(controls = controls) > cap.rows) {
        invalid(reason = f"the controls need ${rows_used(controls = controls)} rows and Discord fits ${cap.rows} on a message: buttons pack ${cap.buttons_per_row} to a row and each dropdown takes one of its own")
      } else {
        valid()
      }
    }
  }
}
